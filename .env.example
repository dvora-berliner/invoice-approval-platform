# LLM provider (swappable per M15 - decision-service reads this at startup)
LLM_PROVIDER=gemini

# Redis - Dapr state store + pub/sub backend for all services except audit-service
REDIS_HOST=redis
REDIS_PORT=6379

# Postgres - dedicated store for audit-service (F8/F9 aggregation and trail queries)
# POSTGRES_PASSWORD here only seeds the postgres container itself on first boot;
# audit-service reads its own copy via Dapr secrets (secrets.json), not this env var -
# keep the two in sync manually for local dev.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=audit
POSTGRES_USER=approvalflow
POSTGRES_PASSWORD=change-me

# Dapr sidecar ports
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001

# Actual secret values (Gemini key, Postgres password) live in secrets.json,
# read by decision-service/audit-service via the Dapr secrets API - see secrets.json.example.
